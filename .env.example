# Copy to .env and adjust. Every key is optional — built-in defaults work as-is.
# SQLite source of truth (repo-relative or absolute path).
DATABASE_PATH=database/main_database.db
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Training knobs (defaults = thesis Table 5).
ML_LOOK_BACK=28
ML_PREDICTION_HORIZON=5
ML_RANDOM_STATE=42
ML_HIDDEN_LAYERS=32,16
ML_PROJECTION_DIM=64
ML_LSTM_DIM=64
ML_LSTM_LOOKBACK=28
ML_FUSION_INPUT_DIM=144
ML_FUSION_OUTPUT_DIM=3
